      "offset_ms": 100500,
      "payload": {
        "source": "portal"
      },
      "text": "Thanks for your time, James. We'll text you a number to call if you want free help with your renewal. Keep an eye out for that yellow envelope, and don't set it aside. Take care!",
      "type": "utterance"
    }
