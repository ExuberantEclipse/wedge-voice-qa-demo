    },
    {
      "actor": "caller",
      "id": "0b8f6d9e-aa37-4bdf-ba36-204aee2bc356",
      "offset_ms": 81300,
      "payload": {
        "source": "portal"
      },
      "text": "You can call me tomorrow afternoon.",
