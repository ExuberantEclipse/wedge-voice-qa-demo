    {
      "actor": "agent",
      "id": "7e48c2eb-b63d-4319-8194-bca0df606255",
      "offset_ms": 44700,
      "payload": {
        "source": "portal"
      },
      "text": "And are you planning to keep Universal Community Health Center as your Medi-Cal primary care \u2014 your main doctor's office?",
      "type": "utterance"
    },
    {
      "actor": "caller",
      "id": "33b216ae-3bc1-4ccd-a0cf-bee1de10437f",
      "offset_ms": 55200,
      "payload": {
        "source": "portal"
      },
      "text": "Yes. That's right.",
      "type": "utterance"
    },
    {
      "actor": "agent",
      "id": "55cf5bea-5648-4041-9bea-c17185c8779a",
      "offset_ms": 56800,
      "payload": {
        "source": "portal"
      },
      "text": "Medi-Cal is checking everyone's coverage this year. You'll get a renewal packet in the mail from the county \u2014 usually a yellow envelope, and it has a due date on it. Please don't set it aside. If you'd like help filling it out, we do that for free, over the phone or right at the clinic. Would you like me to arrange that help for you?",
      "type": "utterance"
    },
    {
      "actor": "caller",
      "id": "9366712c-94fa-46d5-bb47-3cf4675a2a37",
      "offset_ms": 83200,
      "payload": {
        "source": "portal"
      },
      "text": "No. Thank you. But you can call me back if my renewal paperwork is actually still missing.",
      "type": "utterance"
    },
    {
      "actor": "agent",
      "id": "e5f598af-d338-494d-863c-cb143a1939b2",
      "offset_ms": 83300,
      "payload": {
        "source": "portal"
      },
      "text": "No problem at all \u2014 what day and time is better to call you back?",
      "type": "utterance"
    },
    {
      "actor": "caller",
      "id": "1b088586-5776-43a5-9000-38a463d0c94d",
      "offset_ms": 91800,
      "payload": {
        "source": "portal"
      },
      "text": "That is not what I agreed to.",
      "type": "utterance"
    },
    {
      "actor": "agent",
      "id": "e8bf8f87-fa6a-4eda-8d43-0098b49d9c58",
      "offset_ms": 91800,
      "payload": {
        "source": "portal"
      },
      "text": "Sorry for the misunderstanding. Just to clarify, would you prefer us to call you back only if your renewal paperwork is still missing, or would you like help with it now?",
      "type": "utterance"
    },
    {
      "actor": "caller",
      "id": "21fe7b77-9ab1-4c37-a6bf-7ec57793e9c3",
      "offset_ms": 107400,
      "payload": {
        "source": "portal"
      },
      "text": "Yes. Only call me back if the paperwork is still missing.",
      "type": "utterance"
    },
    {
      "actor": "agent",
      "id": "61f45d0c-4e9a-42e5-a24a-6cebec68237b",
      "offset_ms": 107500,
      "payload": {
        "source": "portal"
      },
      "text": "Got it. What day and time would work best for a callback if needed?",
      "type": "utterance"
    },
    {
      "actor": "caller",
      "id": "d322d010-81fb-4b2a-aad6-24a8afb3d259",
      "offset_ms": 118000,
      "payload": {
        "source": "portal"
      },
      "text": "I don't have a specific time. Just check the paperwork first.",
      "type": "utterance"
    },
