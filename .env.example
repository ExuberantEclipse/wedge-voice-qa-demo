# LiveKit Cloud project credentials (standard names used by the SDK).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Supabase server-side credentials. Never put the service-role key in a browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The LiveKit agent name targeted by the inbound SIP dispatch rule.
QA_AGENT_NAME=qa-simulated-caller

# The dedicated DID that the demo portal calls, in E.164 form.
QA_CALLED_NUMBER=+15551234567

# LiveKit Inference defaults. Override these if the project uses other models.
QA_STT_MODEL=assemblyai/universal-3-5-pro
QA_LLM_MODEL=google/gemma-4-31b-it
QA_GRADER_MODEL=openai/gpt-4.1-mini
QA_TTS_MODEL=fishaudio/s2.1-pro
QA_TTS_VOICE=fa4c9eb3dccc4806b382b40d61c6b10a

# Optional: authorized Wedge test-portal batch execution.
WEDGE_PORTAL_URL=https://test-portal-livid.vercel.app
WEDGE_PORTAL_ACCESS_CODE=
WEDGE_PORTAL_TESTER_NAME=
WEDGE_PORTAL_TESTER_EMAIL=
WEDGE_PORTAL_PERSONA_ID=

# Optional: Twilio inbound caller-identification demo. Keep every value server-side.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_PUBLIC_BASE_URL=https://your-public-https-host.example
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TWILIO_DEMO_PEPPER=
TWILIO_DEMO_DATA_PATH=.twilio-demo/members.json
# Keep true outside isolated local tests.
TWILIO_VALIDATE_SIGNATURES=true

# Vapi inbound caller-identification demo (server-side only)
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_PUBLIC_BASE_URL=https://your-public-https-host.example
VAPI_WEBHOOK_SECRET=
VAPI_DEMO_PEPPER=
VAPI_DEMO_DATA_PATH=.vapi-demo/members.json
VAPI_DEMO_STATE_PATH=.vapi-demo/vapi-number.json

